# Example only. The Go binaries read process environment, not .env automatically.
# Never commit a populated copy. Docker Compose reads an ignored .env copy.
DATABASE_URL=postgres://weagent:URL_ENCODED_PASSWORD@127.0.0.1:5432/weagent?sslmode=disable
GATEWAY_HMAC_KEY=
AUTH_MODE=wechat
WECHAT_APP_ID=
WECHAT_APP_SECRET=
LISTEN_ADDR=127.0.0.1:8080
ALLOWED_ORIGINS=
# Only explicitly trusted ingress peers; ingress must overwrite X-Real-IP.
TRUSTED_PROXY_CIDRS=
MAX_CONNECTIONS=256
MAX_INFLIGHT=128
HEARTBEAT_INTERVAL=15s
OFFLINE_AFTER=45s
COMMAND_TTL=15s
MAINTENANCE_INTERVAL=1m
CONTENT_RETENTION_DAYS=30
METADATA_RETENTION_DAYS=90
CHANGES_RETENTION_DAYS=7

# Compose only: DATABASE_URL uses hostname db, with the same URL-encoded password.
POSTGRES_PASSWORD=
